          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const agora = new Date();\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const evento = item.json;\n\n  if (!evento.start || !evento.start.dateTime) continue;\n  \n  // Pula se já enviou lembrete\n  if (evento.summary && evento.summary.includes('✅LEMBRETE')) continue;\n\n  const inicio = new Date(evento.start.dateTime);\n  const diffMinutos = (inicio - agora) / 60000;\n\n  if (diffMinutos < 45 || diffMinutos > 75) continue;\n\n  const partes = evento.summary ? evento.summary.split(' - ') : [];\n  if (partes.length < 2) continue;\n\n  const nome = partes[0].trim();\n  const telefone = partes[1].trim();\n\n  const hora = inicio.toLocaleTimeString('pt-BR', {\n    hour: '2-digit',\n    minute: '2-digit',\n    timeZone: 'America/Sao_Paulo'\n  });\n\n  resultados.push({\n    json: {\n      eventId: evento.id,\n      telefone,\n      nome,\n      hora,\n      mensagem: `Olá ${nome}! ✂️ Daqui a 1 hora é o seu horário na Relts Barbearia às ${hora}. Te esperamos! 😊\\n\\n— Relts Barbearia`\n    }\n  });\n}\n\nreturn resultados.length > 0 ? resultados : [{ json: { vazio: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
